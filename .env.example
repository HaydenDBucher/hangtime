# Ticketmaster Discovery API key for current Columbus event listings.
# Create a local .env file and keep the real key out of version control.
VITE_TICKETMASTER_API_KEY=replace_with_your_key

# Optional production authentication. Without these values, Hangtime uses a
# clearly labeled browser-local prototype account system.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_anon_key
