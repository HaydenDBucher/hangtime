# Ticketmaster Discovery API key for current events within three miles of Ohio State.
# Create a local .env file and keep the real key out of version control.
VITE_TICKETMASTER_API_KEY=replace_with_your_key

# Optional production authentication. Without these values, Hangtime uses a
# clearly labeled browser-local prototype account system.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_anon_key

# Optional Uber client ID used only to improve the provider deep link. Live fare
# estimates require separate provider approval and must be fetched server-side.
VITE_UBER_CLIENT_ID=replace_with_your_client_id
